# --- Paths ---
CFX_SERVER_RESOURCES=E:/Full Life Roleplay 2.0/server/resources
CFX_STATE_DIR=./state
CFX_CACHE_DIR=./cache
CFX_STAGING_DIR=./staging
CFX_BACKUP_DIR=./state/backups
CFX_COOKIE_FILE=./.cookies.json
# Dedicated Playwright profile dir (isolated from real Chrome; persistent between
# logins so Cfx's device-verification prompt fires once, not every login).
CFX_PLAYWRIGHT_PROFILE_DIR=./.playwright-profile

# --- Auth ---
# file       (default) — manual cookie export; works everywhere
# playwright — headed Chromium login (requires `npx playwright install chromium`)
CFX_AUTH_MODE=file

# --- Optional overrides ---
CFX_API_BASE=https://portal-api.cfx.re
CFX_BACKUP_RETAIN=5
CFX_RATE_LIMIT_TTL_MS=3600000
CFX_STALL_TIMEOUT_MS=60000

# --- Preservation (Phase 1.5) ---
# Master switch for Layer 2 customization preservation. Default: on.
# Set to 0/false/off/no to revert to v0.1.0 plain-swap behavior AND skip
# pristine capture entirely. Pure-rollback path if you hit a preservation bug.
CFX_SYNC_PRESERVE=1

# Pristine baseline dirs. Override if you need pristine on a different disk
# (e.g. SSD for state, HDD for pristine snapshots).
# Defaults: <CFX_STATE_DIR>/pristine and <CFX_STATE_DIR>/pristine-history
CFX_PRISTINE_DIR=./state/pristine
CFX_PRISTINE_HISTORY_DIR=./state/pristine-history

# Where staged-for-merge conflict sidecars land.
# Default: <CFX_STATE_DIR>/conflicts
CFX_CONFLICT_DIR=./state/conflicts
