# --- Paths ---
CFX_SERVER_RESOURCES=E:/Full Life Roleplay 2.0/server/resources
CFX_STATE_DIR=./state
CFX_CACHE_DIR=./cache
CFX_STAGING_DIR=./staging
CFX_BACKUP_DIR=./state/backups
CFX_COOKIE_FILE=./.cookies.json

# --- Auth ---
# file       (default) — manual cookie export; works everywhere
# playwright — headed Chromium login (requires `npx playwright install chromium`)
CFX_AUTH_MODE=file

# --- Optional overrides ---
CFX_API_BASE=https://portal-api.cfx.re
CFX_BACKUP_RETAIN=5
CFX_RATE_LIMIT_TTL_MS=3600000
CFX_STALL_TIMEOUT_MS=60000
