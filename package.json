{
  "name": "cfx-sync-mcp",
  "version": "0.5.0",
  "description": "Open-source MCP server that syncs Cfx.re Portal granted assets into a local FiveM/RedM server. Read-only toward the portal; never transfers, gifts, or modifies grants.",
  "type": "module",
  "bin": {
    "cfx-sync-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint src tests --ext .ts",
    "grep-guard": "tsx scripts/grep-guard.ts",
    "refresh-fixtures": "tsx scripts/refresh-fixtures.ts",
    "ci": "npm run typecheck && npm run lint && npm run grep-guard && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/semver": "7.7.1",
    "flrp-resource-preservation": "github:flashwing-nwrp/flrp-resource-preservation#v1.0.0",
    "playwright": "1.59.1",
    "semver": "7.7.4",
    "undici": "6.29.1",
    "yauzl-promise": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/yauzl-promise": "4.0.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "jszip": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.5.4",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
