# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 — npm will warn "Unknown project config"
# (this isn't an npm config key; it's an env var npm exports to lifecycle
# scripts including Playwright's postinstall). Do not remove.
# See: https://playwright.dev/docs/browsers#skip-browser-downloads
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
save-exact=true
